        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. GENERATE SAMPLE MESSY DAIRY DATASET (105 rows, including duplicates & errors)\n",
        "np.random.seed(42)\n",
        "n = 100\n",
        "df_raw = pd.DataFrame({\n",
        "    'Cow_ID': [f'COW_{1000+i}' for i in range(n)],\n",
        "    'Farm_Region': np.random.choice(['Debrecen_HU', 'Chuy_KG'], n),\n",
        "    'Parity': np.random.choice([1, 2, 3, 4, np.nan], n, p=[0.3, 0.3, 0.2, 0.15, 0.05]),\n",
        "    'Daily_Milk_kg': np.round(np.random.normal(31, 6, n), 1),\n",
        "    'Calving_Interval_days': np.random.randint(340, 460, n),\n",
        "    'SCC_cells_ml': np.random.randint(50000, 350000, n)\n",
        "})\n",
        "\n",
        "# Inject realistic farm logging errors (what you catch during EDA)\n",
        "df_raw.loc[2, 'Daily_Milk_kg'] = 145.0       # Impossible sensor spike / typo\n",
        "df_raw.loc[5, 'Daily_Milk_kg'] = -4.0        # Negative error\n",
        "df_raw.loc[10, 'Calving_Interval_days'] = 120 # Biologically impossible calving interval\n",
        "df_raw.loc[15, 'SCC_cells_ml'] = np.nan      # Missing lab test\n",
        "df_raw = pd.concat([df_raw, df_raw.iloc[:5]], ignore_index=True) # 5 accidental duplicate rows\n",
        "\n",
        "print(f\"RAW DATASET: {len(df_raw)} rows | Missing values:\\n{df_raw.isnull().sum()}\\n\")\n",
        "\n",
        "# 2. DATA CLEANING PIPELINE (What you explain to Bert)\n",
        "df_clean = df_raw.drop_duplicates(subset=['Cow_ID']).copy()\n",
        "\n",
        "# Filter out biologically impossible outliers\n",
        "df_clean = df_clean[(df_clean['Daily_Milk_kg'] > 5) & (df_clean['Daily_Milk_kg'] < 75)]\n",
        "df_clean = df_clean[df_clean['Calving_Interval_days'] >= 280]\n",
        "\n",
        "# Fill missing Parity with median and missing SCC with group median\n",
        "df_clean['Parity'] = df_clean['Parity'].fillna(df_clean['Parity'].median()).astype(int)\n",
        "df_clean['SCC_cells_ml'] = df_clean['SCC_cells_ml'].fillna(df_clean['SCC_cells_ml'].median())\n",
        "\n",
        "# Create a Somatic Cell Score / Subclinical Mastitis Flag (>200,000 cells/mL)\n",
        "df_clean['High_SCC_Risk'] = np.where(df_clean['SCC_cells_ml'] > 200000, 'Elevated (>200k)', 'Normal (<=200k)')\n",
        "\n",
        "print(f\"CLEAN DATASET: {len(df_clean)} valid cows ready for analysis.\\n\")\n",
        "print(df_clean.groupby('Farm_Region')[['Daily_Milk_kg', 'Calving_Interval_days', 'SCC_cells_ml']].mean().round(1))\n",
        "\n",
        "# 3. VISUALIZATION (EDA CHARTS)\n",
        "fig, axes = plt.subplots(1, 2, figsize=(12, 4.5))\n",
        "\n",
        "# Chart 1: Milk Yield by Parity (Lactation Number)\n",
        "parity_means = df_clean.groupby('Parity')['Daily_Milk_kg'].mean()\n",
        "axes[0].bar(parity_means.index.astype(str), parity_means.values, color='#1f77b4', edgecolor='black')\n",
        "axes[0].set_title('Average Daily Milk Yield by Parity')\n",
        "axes[0].set_xlabel('Parity (Lactation Number)')\n",
        "axes[0].set_ylabel('Milk Yield (kg/day)')\n",
        "axes[0].grid(axis='y', linestyle='--', alpha=0.5)\n",
        "\n",
        "# Chart 2: Milk Yield vs. Somatic Cell Count Risk\n",
        "groups = [df_clean[df_clean['High_SCC_Risk'] == 'Normal (<=200k)']['Daily_Milk_kg'],\n",
        "          df_clean[df_clean['High_SCC_Risk'] == 'Elevated (>200k)']['Daily_Milk_kg']]\n",
        "axes[1].boxplot(groups, labels=['Normal SCC (<=200k)', 'Elevated SCC (>200k)'], patch_artist=True,\n",
        "                boxprops=dict(facecolor='#2ca02c', alpha=0.6))\n",
        "axes[1].set_title('Daily Milk Yield by Udder Health Status (SCC)')\n",
        "axes[1].set_ylabel('Milk Yield (kg/day)')\n",
        "axes[1].grid(axis='y', linestyle='--', alpha=0.5)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
